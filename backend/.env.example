# Database - defaults to local SQLite file if unset.
# For Postgres use: postgresql://user:password@localhost:5432/vinayaka_youth
DATABASE_URL=sqlite:///./vinayaka_youth.db

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial admin account, created automatically on first startup if no admin exists
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vinayakayouth.org
ADMIN_PASSWORD=change-this-password

# Where uploaded media files are stored on disk
MEDIA_ROOT=./media
MEDIA_URL_PREFIX=/media
